# Copy to .env and fill in. Never commit .env.
# Real environment variables take precedence over values in this file.

# CQC API subscription key (primary key from https://api-portal.service.cqc.org.uk/profile)
CQC_API_KEY=

# Companies House REST API key (https://developer.company-information.service.gov.uk/)
COMPANIES_HOUSE_API_KEY=

# Optional: path to the YAML config (default: config/signals.yaml)
# SIGNALS_CONFIG=config/signals.yaml
