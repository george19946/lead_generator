# The usual place for your keys is ~/Signals/keys.env: create it with `uv run signals keys`.
# A .env file in the code folder (copied from this one) also works, mainly for development;
# keys.env wins over it, and real environment variables win over both. Never commit either file.

# CQC API subscription key (primary key from https://api-portal.service.cqc.org.uk/profile)
CQC_API_KEY=

# Companies House REST API key (https://developer.company-information.service.gov.uk/)
COMPANIES_HOUSE_API_KEY=

# Optional: a different data home (default ~/Signals) or config file (default ~/Signals/signals.yaml)
# SIGNALS_HOME=/path/to/Signals
# SIGNALS_CONFIG=/path/to/signals.yaml
